	optdepends = xdg-desktop-portal-kde: portal backend for KDE Plasma
	optdepends = gjs: GNOME Shell search provider for chats and Claude Code sessions
	optdepends = gvfs: move files to trash from the app
	optdepends = trash-cli: move files to trash from the app
	optdepends = libpulse: audio output, via PulseAudio or pipewire-pulse
	optdepends = libspeechd: text-to-speech
	optdepends = libva: hardware-accelerated video decoding
	optdepends = vulkan-icd-loader: hardware-accelerated rendering via Vulkan
	optdepends = apparmor: load the shipped userns profile when AppArmor is enabled
	optdepends = virtiofsd: host directory sharing for the Cowork sandbox VM
	optdepends = bubblewrap: filesystem isolation for Claude Code sandboxed Bash
	optdepends = socat: network proxy relay for Claude Code sandboxed Bash
	optdepends = openssh: system ssh client for Claude Code remote sessions
